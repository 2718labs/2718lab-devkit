{
  "schema": "2718lab-devkit/fastlane-routing-policy-v5",
  "version": 5,
  "role_floors": {
    "prewarm": 10,
    "read_analysis": 10,
    "documentation": 10,
    "execution": 20,
    "recovery": 30,
    "verification": 30,
    "review": 50,
    "integration": 60,
    "design": 90,
    "acceptance": 90
  },
  "risk_floors": {
    "cross_module": 50,
    "database_work": 60,
    "migration": 70,
    "security_execution": 80,
    "security_review": 100,
    "destructive_execution": 80,
    "destructive_review": 100,
    "destructive_acceptance": 110,
    "design_conflict": 90,
    "acceptance": 90
  },
  "limits": {
    "maximum_request_bytes": 32768,
    "maximum_tasks": 64,
    "maximum_cache_entries": 128,
    "maximum_gate_reason_codes": 16,
    "maximum_host_models": 8,
    "maximum_total_slots": 8,
    "maximum_scope_items": 8,
    "maximum_dependency_items": 32
  },
  "spark_gate": {
    "required_entitlement": "spark_preview"
  },
  "reason_codes": [
    "invalid_schema",
    "invalid_bounds",
    "invalid_policy_hash",
    "contradictory_profile",
    "access_scope_contradiction",
    "dependency_not_ready",
    "scope_conflict_active",
    "destructive_authorization_missing",
    "lease_unavailable",
    "capability_unavailable",
    "host_model_policy_denied",
    "host_child_route_below_safety_floor",
    "spark_role_excluded",
    "spark_not_severe",
    "spark_not_critical_path",
    "spark_not_static_acceptance",
    "spark_candidate_not_green",
    "spark_scope_not_narrow",
    "spark_competing_writer",
    "spark_exit_not_bounded",
    "spark_prior_attempt",
    "spark_long_regression",
    "spark_architecture_or_migration",
    "spark_entitlement_unavailable",
    "FASTLANE_SCHEMA_UPGRADE_REQUIRED"
  ]
}
